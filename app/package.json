{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:gen": "node ../scripts/dbml2sql.mjs",
    "db:apply": "psql \"$DATABASE_URL\" -f ../db/schema.sql",
    "db:psql": "psql \"$DATABASE_URL\"",
    "electron": "electron .",
    "dev:desktop": "concurrently -k -n next,electron -c cyan,magenta \"pnpm dev\" \"wait-on http://localhost:3000/panel && electron .\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@dbml/core": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "packageManager": "pnpm@10.17.1",
  "main": "electron/main.js"
}
