// =====================================================================
//  Apple Music CLI — 데이터 모델
//  작성일 2026-09-09 (D2)
//
//  도출 근거: docs/06-화면-필드.md 의 화면 표시 필드 전수 열거
//  실측 근거: docs/05-스파이크-라이브러리-실측.md
//
//  제출 시 파일명: 판교_3반_{이름}_{프로젝트명}-DB.dbml
// =====================================================================

Project apple_music_cli {
  database_type: 'PostgreSQL'
  Note: '''
    내가 이미 가진 음악을 자연어로 파고, 왜 골랐는지 말해주고,
    스킵하면 배우는 터미널 뮤직 플레이어.

    핵심 설계 판단
    1. `track.last_played_at IS NULL` 이 곧 "한 번도 듣지 않은 곡"이며 묘비의 1차 기준이다.
    2. `track.persistent_id` 가 Music.app 과의 동기화 키다.
    3. `loved` 와 `bpm` 은 실측 결과 사용 불가하여 스키마에서 제외했다.
    4. 반응(reaction)은 키 입력이 아니라 재생 상태 폴링으로 수집된다.
    5. 자연어 요청은 session_turn 한 행으로 남으며 비동기 잡의 상태를 담는다.
  '''
}

// ---------------------------------------------------------------------
//  Enum
// ---------------------------------------------------------------------

Enum track_source {
  file    [note: 'file track — 로컬 음원']
  shared  [note: 'shared track — Apple Music 스트리밍. 실측 라이브러리의 97%']
}

Enum tag_kind {
  mood     [note: '차분한, 격렬한, 쓸쓸한']
  context  [note: '코딩, 운동, 새벽, 이동']
  energy   [note: 'low, mid, high']
}

Enum tag_source {
  ai    [note: 'L1 색인이 부여']
  user  [note: '사용자가 직접 부여·수정']
}

Enum session_status {
  active
  ended
}

Enum turn_status {
  queued
  running
  succeeded
  failed
  cancelled
}

Enum turn_intent {
  generate_queue  [note: 'F1 자연어 큐 생성']
  refine_queue    [note: 'F3 되물어 재편성']
  explain         [note: '"이거 왜 골랐어?"']
  react           [note: '"이건 별로야"']
  unknown         [note: 'L2 분류 실패']
}

Enum queue_item_state {
  pending
  playing
  played
  skipped
  removed
}

Enum queue_item_origin {
  generation   [note: 'F1 자연어 큐 생성']
  revive       [note: 'F7 묘비에서 되살림']
  recognition  [note: 'F11 인식 결과에서 투입']
  manual       [note: '사용자 직접 추가']
}

Enum reaction_type {
  skip_early        [note: '3초 이내 이탈 — 강한 부정']
  skip_mid          [note: '중간 이탈 — 약한 부정']
  complete          [note: '완청 — 긍정']
  repeat            [note: '반복 재생 — 강한 긍정']
  favorite          [note: 'Music.app favorited 반영']
  dislike           [note: 'Music.app disliked 반영']
  explicit_positive [note: '"이런 거 좋아"']
  explicit_negative [note: '"이건 별로야"']
}

Enum reaction_detector {
  poll  [note: '재생 위치 폴링으로 관찰 — 기본']
  user  [note: '자연어로 명시적 표명']
}

Enum sync_status {
  running
  succeeded
  failed
}

// ---------------------------------------------------------------------
//  사용자
// ---------------------------------------------------------------------

Table app_user {
  id            bigint       [pk, increment]
  display_name  varchar(100) [not null]
  created_at    timestamptz  [not null, default: `now()`]

  Note: '1인용 도구이나 서버가 이력을 보관하므로 소유 주체를 둔다.'
}

// ---------------------------------------------------------------------
//  음악 카탈로그  (Artist 1:N Album 1:N Track)
// ---------------------------------------------------------------------

Table artist {
  id          bigint       [pk, increment]
  name        varchar(255) [not null, unique]
  created_at  timestamptz  [not null, default: `now()`]
}

Table album {
  id            bigint       [pk, increment]
  artist_id     bigint       [not null, ref: > artist.id, note: '앨범 아티스트']
  title         varchar(255) [not null]
  release_year  smallint     [null]
  artwork_url   text         [null, note: 'Apple Music API 제공. S1 앨범 아트']
  created_at    timestamptz  [not null, default: `now()`]

  indexes {
    (artist_id, title) [unique]
  }
}

Table track {
  id               bigint             [pk, increment]
  user_id          bigint             [not null, ref: > app_user.id]
  artist_id        bigint             [not null, ref: > artist.id, note: '곡 아티스트. 앨범 아티스트와 다를 수 있다(피처링·컴필레이션)']
  album_id         bigint             [null, ref: > album.id, note: '싱글은 NULL']

  persistent_id    varchar(32)        [not null, note: 'Music.app persistent ID. 동기화 키']
  apple_music_id   varchar(64)        [null, note: '카탈로그 ID. F11 인식 대조에 사용']
  isrc             varchar(15)        [null]

  title            varchar(255)       [not null]
  genre            varchar(100)       [null]
  year             smallint           [null]
  duration_ms      integer            [not null]
  track_number     smallint           [null]
  disc_number      smallint           [null]

  source           track_source       [not null]
  cloud_status     varchar(32)        [null, note: 'subscription / purchased / matched / uploaded. E6 판단 근거']

  play_count       integer            [not null, default: 0]
  last_played_at   timestamptz        [null, note: '★ NULL = 한 번도 재생하지 않음. 실측 36.3%. 묘비의 1차 기준']
  skip_count       integer            [not null, default: 0]
  last_skipped_at  timestamptz        [null]
  favorited        boolean            [not null, default: false, note: 'loved 는 접근 불가하여 favorited 사용']
  disliked         boolean            [not null, default: false]
  rating           smallint           [null, note: '0-100']

  added_at         timestamptz        [not null, note: 'Music.app date added']
  excluded         boolean            [not null, default: false, note: 'F7 묘비 정리. 원본은 삭제하지 않는다']
  synced_at        timestamptz        [not null]

  indexes {
    (user_id, persistent_id) [unique, name: 'uq_track_persistent']
    apple_music_id
    last_played_at [note: '묘비·진단 조회']
    (user_id, excluded)
  }

  Note: 'bpm 과 loved 는 실측 결과 사용 불가하여 제외했다. docs/05 참조.'
}

// ---------------------------------------------------------------------
//  태그  (Track M:N Tag) — L1 색인 결과
// ---------------------------------------------------------------------

Table tag {
  id          bigint       [pk, increment]
  name        varchar(50)  [not null]
  kind        tag_kind     [not null]
  created_at  timestamptz  [not null, default: `now()`]

  indexes {
    (kind, name) [unique]
  }

  Note: 'Apple 은 오디오 특성을 제공하지 않으므로 L1 이 메타데이터에서 추론해 채운다.'
}

Table track_tag {
  track_id     bigint       [not null, ref: > track.id]
  tag_id       bigint       [not null, ref: > tag.id]
  confidence   numeric(3,2) [not null, default: 1.00, note: '0.00-1.00']
  source       tag_source   [not null, default: 'ai']
  created_at   timestamptz  [not null, default: `now()`]

  indexes {
    (track_id, tag_id) [pk]
    tag_id
  }
}

// ---------------------------------------------------------------------
//  청취 세션
// ---------------------------------------------------------------------

Table listening_session {
  id                 bigint          [pk, increment]
  user_id            bigint          [not null, ref: > app_user.id]
  title              varchar(200)    [not null, note: '최초 요청에서 생성. S1 헤더']
  prompt             text            [not null, note: '최초 자연어 입력 원문']
  status             session_status  [not null, default: 'active']

  prompt_tokens      integer         [not null, default: 0]
  completion_tokens  integer         [not null, default: 0]
  cost_usd           numeric(10,6)   [not null, default: 0, note: 'S1 상태줄 누적 비용']

  started_at         timestamptz     [not null, default: `now()`]
  ended_at           timestamptz     [null]

  indexes {
    (user_id, started_at)
  }
}

Table session_turn {
  id                 bigint        [pk, increment]
  session_id         bigint        [not null, ref: > listening_session.id]
  prompt             text          [not null, note: '사용자 자연어 입력 원문']
  intent             turn_intent   [null, note: 'L2 분류 결과. 분류 전에는 NULL']
  status             turn_status   [not null, default: 'queued']
  assistant_message  text          [null, note: '사용자에게 보여줄 응답 문장']

  error_code         varchar(64)   [null, note: 'MODEL_UNAVAILABLE 등. API ErrorCode 와 동일 어휘']
  error_message      text          [null]

  prompt_tokens      integer       [not null, default: 0]
  completion_tokens  integer       [not null, default: 0]
  cost_usd           numeric(10,6) [not null, default: 0]

  created_at         timestamptz   [not null, default: `now()`]
  finished_at        timestamptz   [null]

  indexes {
    (session_id, created_at)
    status
  }

  Note: '''
    자연어 요청 한 건 = 한 행. 비동기 잡의 상태를 담는다.
    POST /sessions/{id}/turns 가 202 와 함께 이 행을 만들고,
    GET /turns/{id} 가 이 행을 조회한다.

    status = failed 여도 기존 큐의 재생은 계속된다.
  '''
}

Table queue_item {
  id          bigint             [pk, increment]
  session_id  bigint             [not null, ref: > listening_session.id]
  turn_id     bigint             [null, ref: > session_turn.id, note: '어느 요청에서 나온 곡인지. 되살리기·수동 추가는 NULL']
  track_id    bigint             [not null, ref: > track.id]
  position    smallint           [not null]
  reason      text               [null, note: '★ F2 선정 근거 한 줄. L4 실패 시 NULL 이며 재생은 계속된다']
  state       queue_item_state   [not null, default: 'pending']
  origin      queue_item_origin  [not null, default: 'generation']
  created_at  timestamptz        [not null, default: `now()`]

  indexes {
    (session_id, position) [unique]
    track_id
  }
}

Table reaction {
  id            bigint             [pk, increment]
  queue_item_id bigint             [not null, ref: > queue_item.id]
  type          reaction_type      [not null]
  detected_by   reaction_detector  [not null, default: 'poll']
  position_sec  numeric(7,2)       [null, note: '이탈 시점. skip_early 판정 근거']
  created_at    timestamptz        [not null, default: `now()`]

  indexes {
    queue_item_id
    (type, created_at)
  }

  Note: '키 입력이 아니라 재생 위치 폴링(1초 주기)으로 수집된다. docs/03 6절 참조.'
}

// ---------------------------------------------------------------------
//  취향 규칙 — L5 산출물
// ---------------------------------------------------------------------

Table taste_rule {
  id              bigint       [pk, increment]
  user_id         bigint       [not null, ref: > app_user.id]
  statement       text         [not null, note: 'S4 표시 문장. "새벽 시간대에 가사 있는 곡을 회피"']
  condition       jsonb        [not null, note: 'L3 선곡이 소비하는 구조화 조건']
  evidence_count  integer      [not null, default: 0, note: '근거가 된 반응 수. S4 표시']
  active          boolean      [not null, default: true]
  derived_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, active)
  }
}

// ---------------------------------------------------------------------
//  플레이리스트  (Track M:N Playlist)
// ---------------------------------------------------------------------

Table playlist {
  id                       bigint       [pk, increment]
  user_id                  bigint       [not null, ref: > app_user.id]
  name                     varchar(200) [not null]
  apple_music_playlist_id  varchar(64)  [null, note: 'Music.app 반영 후 채워진다. 실패 시 NULL']
  source_session_id        bigint       [null, ref: > listening_session.id, note: 'F9 어느 큐에서 나왔는지']
  created_at               timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
  }
}

Table playlist_track {
  playlist_id  bigint       [not null, ref: > playlist.id]
  track_id     bigint       [not null, ref: > track.id]
  position     smallint     [not null]
  added_at     timestamptz  [not null, default: `now()`]

  indexes {
    (playlist_id, position) [pk]
    track_id
  }
}

// ---------------------------------------------------------------------
//  Shazam 인식  (F10 · F11)
// ---------------------------------------------------------------------

Table recognition {
  id                bigint       [pk, increment]
  user_id           bigint       [not null, ref: > app_user.id]
  session_id        bigint       [null, ref: > listening_session.id, note: '세션 밖에서도 인식할 수 있다']

  shazam_id         varchar(64)  [not null]
  apple_music_id    varchar(64)  [null]
  isrc              varchar(15)  [null]
  title             varchar(255) [not null]
  artist_name       varchar(255) [not null]
  year              smallint     [null]
  genre             varchar(100) [null]
  artwork_url       text         [null]

  matched_track_id  bigint       [null, ref: > track.id, note: '★ F11. NULL = 라이브러리 미보유. apple_music_id / isrc 정확 일치로만 판정하며 AI 를 쓰지 않는다']
  recognized_at     timestamptz  [not null, default: `now()`]

  indexes {
    (user_id, recognized_at)
    matched_track_id
  }
}

// ---------------------------------------------------------------------
//  라이브러리 동기화 잡  (F6 · E3)
// ---------------------------------------------------------------------

Table sync_run {
  id            bigint       [pk, increment]
  user_id       bigint       [not null, ref: > app_user.id]
  status        sync_status  [not null, default: 'running']
  track_count   integer      [null, note: '처리된 곡 수. S3 표시']
  tagged_count  integer      [null, note: 'L1 태깅이 완료된 곡 수']
  error         text         [null, note: 'E1 권한 거부 · E2 Music.app 미실행 등']
  started_at    timestamptz  [not null, default: `now()`]
  finished_at   timestamptz  [null]

  indexes {
    (user_id, started_at)
  }

  Note: '동기화는 비동기 잡이다. POST 는 202 를 반환하고 클라이언트가 상태를 조회한다.'
}
